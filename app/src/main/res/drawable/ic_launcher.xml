<?xml version="1.0" encoding="utf-8"?>
<!--
    Cody's launcher mark.

    A rounded square carrying a face: two eyes and a smile. The same shape the app draws with Compose
    in the drawer header and on the initialising screen (ui/screens/CodyMark.kt) — kept in step by
    hand because a VectorDrawable cannot call a composable.

    Geometry mirrors CodyMark.drawFace EXACTLY, on a 108-unit viewport with the tile filling
    21..87 (66 units = one CodyMark "side", centre 54):

      eye radius   0.095*66 = 6.3, spread 0.165*66 = 10.9, eye centre y 54-0.06*66 = 50.0
      smile        0.34*66 = 22.4 wide, 0.26*66 = 17.2 tall, stroke 0.065*66 = 4.3
      corners      0.3*66 = 19.8 (same 0.3 ratio CodyMark clips to)
      gradient     horizontal, same 3 stops (Compose linearGradient default runs left to right)
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Base tile. Corner radius 19.8 on a 66-wide square = the 0.3 ratio CodyMark clips to. -->
    <path android:pathData="M40.8,21 h26.4 a19.8,19.8 0 0 1 19.8,19.8 v26.4 a19.8,19.8 0 0 1 -19.8,19.8 h-26.4 a19.8,19.8 0 0 1 -19.8,-19.8 v-26.4 a19.8,19.8 0 0 1 19.8,-19.8 z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="21"
                android:startY="54"
                android:endX="87"
                android:endY="54"
                android:type="linear">
                <item android:offset="0.0" android:color="#FF4A8CFF" />
                <item android:offset="0.5" android:color="#FF7FB4FF" />
                <item android:offset="1.0" android:color="#FFBFE0FF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Two eyes. Circles only — that is the whole point of the mark. -->
    <path android:fillColor="#FFFFFFFF" android:pathData="M36.8,50 m-6.3,0 a6.3,6.3 0 1,0 12.6,0 a6.3,6.3 0 1,0 -12.6,0" />
    <path android:fillColor="#FFFFFFFF" android:pathData="M58.6,50 m-6.3,0 a6.3,6.3 0 1,0 12.6,0 a6.3,6.3 0 1,0 -12.6,0" />

    <!-- Smile: lower arc of the 22.4 x 17.2 CodyMark ellipse, stroked round. -->
    <path
        android:pathData="M43.5,64.2 Q54,75.5 64.5,64.2"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="4.3"
        android:strokeLineCap="round" />
</vector>