<?xml version="1.0" encoding="utf-8"?>
<!--
    Cody's launcher mark.

    A rounded square carrying a face: two eyes and a smile. The same shape the app draws with Compose
    in the drawer header and on the initialising screen (ui/screens/CodyMark.kt) — kept in step by
    hand because a VectorDrawable cannot call a composable.

    Geometry mirrors CodyMark.drawFace, expressed on a 108-unit viewport with the tile filling the
    adaptive-icon safe zone:

      eye radius   5.1, spread 9.9, eye centre y 40.4
      smile        18.4 wide, 14.0 tall, 18..158 degrees, stroke 3.5

    The gradient is a real <gradient> fill rather than the three stacked flat paths an earlier
    version used; that trick bands visibly once the launcher renders the icon at full size.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Base tile. Corner radius 12 on a 66-wide square is the same 0.3 ratio CodyMark clips to. -->
    <path android:pathData="M33,21 h42 a12,12 0 0 1 12,12 v42 a12,12 0 0 1 -12,12 h-42 a12,12 0 0 1 -12,-12 v-42 a12,12 0 0 1 12,-12 z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="21"
                android:startY="21"
                android:endX="87"
                android:endY="87"
                android:type="linear">
                <item android:offset="0.0" android:color="#FF4A8CFF" />
                <item android:offset="0.5" android:color="#FF7FB4FF" />
                <item android:offset="1.0" android:color="#FFBFE0FF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Two eyes. Circles only — that is the whole point of the mark. -->
    <path android:fillColor="#FFFFFFFF" android:pathData="M44.1,40.4 m-5.1,0 a5.1,5.1 0 1,0 10.2,0 a5.1,5.1 0 1,0 -10.2,0" />
    <path android:fillColor="#FFFFFFFF" android:pathData="M63.9,40.4 m-5.1,0 a5.1,5.1 0 1,0 10.2,0 a5.1,5.1 0 1,0 -10.2,0" />

    <!-- Smile: the lower arc of an 18.4 x 14.0 ellipse centred at (54, 47.4). -->
    <path
        android:pathData="M46.4,47.0 Q54,58.2 61.6,47.0"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="3.5"
        android:strokeLineCap="round" />
</vector>